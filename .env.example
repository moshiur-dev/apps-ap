# Copy this file to .env and fill in your MongoDB Atlas details.
# If the password contains @ # / : etc, URL-encode it.
DATABASE_URL="mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/clickup_clone?retryWrites=true&w=majority"

# Long random string used to sign login tokens
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Base URL used in invite links (defaults to WEB_ORIGIN)
WEB_URL="http://localhost:3000"

# --- Invite emails (optional) ---
# Without SMTP, invites still work: the app shows a link you can copy and share.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-char Google "App password">
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Canopy <no-reply@yourdomain.com>"
